#include <stdio.h>
#include <string.h>

int main() {
    FILE *fp;
    char input[100];

    fp = fopen("log.txt", "a");

    if (fp == NULL) {
        printf("File cannot be opened.");
        return 1;
    }

    printf("Enter text (type exit to stop):\n");

    while (1) {
        fgets(input, sizeof(input), stdin);

        if (strcmp(input, "exit\n") == 0)
            break;

        fprintf(fp, "%s", input);
    }

    fclose(fp);

    printf("Input recorded successfully.");

    return 0;
}
